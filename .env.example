DATA_DIR=./data
LLM_BASE_URL=            # OpenAI 兼容地址，含版本前缀（例如 https://host/v1）；留空表示未配置
LLM_API_KEY=             # 不入仓库；留空则降级，不使用任何内置密钥
LLM_MODEL=
LLM_MODE=live            # live | replay（只读缓存）
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_REVISION=      # WP-D 锁定；为空时 setup 不下载模型
COLLECT_MAX_JOBS=30
COLLECT_MAX_MINUTES=20
TASK_BUDGET_CALLS=200
TASK_BUDGET_USD=2.0
LOG_LEVEL=INFO
